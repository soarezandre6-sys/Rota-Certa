<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/navigation_instruction_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="82dp"
        android:background="@drawable/bg_nav_instruction"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/navigation_arrow"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="↑"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navigation_primary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Siga em frente"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navigation_secondary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Aguardando próxima instrução"
                android:textColor="#DDE7F3"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/center_location_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_location_button"
        android:contentDescription="Centralizar na minha localização"
        android:elevation="8dp"
        android:padding="12dp"
        android:src="@drawable/ic_my_location" />

    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_control_panel"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/panel_toggle"
            android:layout_width="72dp"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Recolher ou abrir controles"
            android:gravity="center"
            android:text="⌄"
            android:textColor="#DCE6F2"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/control_panel_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:paddingBottom="9dp"
                android:text="Rota Certa • aguardando GPS"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/start_button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="INICIAR ROTA"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:backgroundTint="@color/start_route_button_tint"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stop_button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="PARAR / SALVAR"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:backgroundTint="#D64545"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saved_routes_button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="ROTAS SALVAS"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#1557A6"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/import_image_button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="IMPORTAR PRINT"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#176B87"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navigate_last_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:text="NAVEGAR NA ROTA SELECIONADA"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#0D47A1"
                app:cornerRadius="14dp" />

            <com.rotacerta.app.ui.ClearRouteButton
                android:id="@+id/clear_route_button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:text="REMOVER ROTA DO MAPA"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#455A64"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
