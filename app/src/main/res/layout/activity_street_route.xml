<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:orientation="vertical">

    <org.maplibre.android.maps.MapView
        android:id="@+id/street_route_map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_control_panel"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Criar rota por ruas"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Digite uma rua por linha, na ordem em que o trajeto deve passar."
            android:textColor="#C9D5E2"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/street_route_city_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#7E93A8"
            android:hint="Cidade/UF (opcional se o GPS estiver disponível)"
            android:inputType="textCapWords"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9EB0C1"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/street_route_streets_input"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#7E93A8"
            android:gravity="top|start"
            android:hint="Rua A&#10;Avenida B&#10;Rua C"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="8"
            android:minLines="4"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9EB0C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/street_route_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Informe as ruas para montar a prévia"
            android:textColor="#E8EEF5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/street_route_build_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="MONTAR ROTA"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#176B87"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/street_route_save_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="SALVAR ROTA"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#0D7A55"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <Button
            android:id="@+id/street_route_back_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#455A64"
            android:text="VOLTAR"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
